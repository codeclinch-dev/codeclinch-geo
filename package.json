{
  "name": "interdeft-geo",
  "version": "0.2.0",
  "description": "Interdeft tools for technical SEO, structured data, website audits, and AI search discovery.",
  "homepage": "https://interdeft.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeclinch-dev/codeclinch-geo.git"
  },
  "bugs": {
    "url": "https://github.com/codeclinch-dev/codeclinch-geo/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "interdeft-geo": "dist/cli.js",
    "geo-seo": "dist/cli.js",
    "codeclinch-geo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "pack:wordpress": "sh scripts/package-wordpress.sh"
  },
  "keywords": [
    "seo",
    "geo",
    "ai-seo",
    "ai-search",
    "generative-engine-optimization",
    "llms.txt",
    "ai-visibility",
    "schema.org",
    "json-ld",
    "sitemap",
    "robots",
    "nextjs",
    "laravel",
    "vite",
    "website-audit",
    "technical-seo",
    "structured-data"
  ],
  "author": "Interdeft",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "parse5": "^7.3.0"
  }
}
